<?xml version="1.0" encoding="utf-8"?>
<!--
  Le manifeste : c'est la "carte d'identité" de l'app pour Android.
  Il déclare les permissions nécessaires et les composants (écran, service, récepteur).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pour appeler l'API de l'IA sur Internet -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Pour lire les numéros des appels entrants -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Pour recevoir les SMS entrants -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- Pour afficher la notification "SMS suspecté spam" (Android 13+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Pour reconnaître les contacts : un contact n'est jamais filtré -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.SpamGuard"
        android:allowBackup="true">

        <!-- L'écran principal : réglages + bouton de test -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- L'écran "Journal & numéros" : historique, listes, signalement 33700 -->
        <activity
            android:name=".JournalActivity"
            android:exported="false" />

        <!--
          Le service de filtrage d'appels : Android lui demande "dois-je laisser
          sonner cet appel ?" pour CHAQUE appel entrant. Il faut ensuite activer
          le rôle "Filtered call screening" dans les réglages du téléphone.
        -->
        <service
            android:name=".SpamCallScreeningService"
            android:permission="android.permission.BIND_SCREENING_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!--
          Le récepteur SMS : Android le prévient à chaque SMS reçu.
          Note : Android n'autorise pas l'application par défaut de SMS à être
          supprimée par une autre app ; on ne peut donc qu'alerter, pas effacer.
        -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="false">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!--
          Le récepteur des boutons de notification : quand on appuie sur
          "TOUJOURS AUTORISER" dans une notification "appel rejeté",
          c'est lui qui exécute l'action, sans ouvrir l'application.
        -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.kestel.spamguard.TOUJOURS_AUTORISER" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
