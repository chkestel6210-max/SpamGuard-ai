<?xml version="1.0" encoding="utf-8"?>
<!--
  L'écran principal, en XML : c'est la façon classique de décrire une interface
  Android. Un ScrollView (contenu défilant) contenant une colonne d'éléments.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SpamGuard"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Filtre les appels et SMS avec une IA." />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Clé API (ex. console.mistral.ai)" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="sk-..."
            android:inputType="textPassword" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="URL de l'API (format OpenAI, sans /chat/completions)" />

        <EditText
            android:id="@+id/etBaseUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Modèle" />

        <EditText
            android:id="@+id/etModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="mistral-small-latest" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swCalls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Filtrer les appels entrants" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/swSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Analyser les SMS entrants" />

        <Button
            android:id="@+id/btnPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Accorder les permissions" />

        <Button
            android:id="@+id/btnEnableRole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activer le filtrage d'appels" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="État : …" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Zone de test : vérifie que l'IA répond bien."
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTestMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:hint="Tape un message à analyser (ou laisse vide pour un exemple)"
            android:inputType="textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnTest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tester l'analyse" />

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="" />

    </LinearLayout>
</ScrollView>
